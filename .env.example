# StrikersFeed environment variables
#
# Phase 1 runs entirely on local mock data and does NOT require any of these.
# They are documented here for the upcoming Supabase integration (Phase 2).
#
# Copy this file to `.env.local` and fill in real values when wiring Supabase.

# --- Supabase (Phase 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Feature flags ---
# When "true", the app sources data from providers backed by Supabase instead
# of the bundled mock data. Defaults to mock in Phase 1.
NEXT_PUBLIC_USE_LIVE_DATA=false
