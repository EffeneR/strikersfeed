# StrikersFeed environment variables
#
# Copy this file to `.env.local` and fill in the values to connect a real
# Supabase project. WITHOUT these, the app runs in demo mode (local mock data +
# a labelled demo session) and everything still works.

# --- Supabase (Phase 2 auth) ---
# Found in your Supabase project: Settings → API.
# Setting BOTH of these switches registration/login to real authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key — never expose to the browser. Required for Steam login
# (find-or-create users) and writing verification. Rotate if ever leaked.
SUPABASE_SERVICE_ROLE_KEY=

# --- Steam identity & verification ---
# Free key from https://steamcommunity.com/dev/apikey — SERVER ONLY (never
# NEXT_PUBLIC). Powers Steam login + profile-code verification.
STEAM_WEB_API_KEY=
# Set to "true" to show the "Continue with Steam" button + verification UI.
NEXT_PUBLIC_STEAM_ENABLED=false
# Canonical site origin, used for the Steam OpenID realm/return URL + app links.
# e.g. http://localhost:3000 locally, https://strikersfeed.club in production.
NEXT_PUBLIC_SITE_URL=

# --- Mobile app promotion (website) ---
# Release state drives all app CTAs: COMING_SOON | BETA | LIVE.
NEXT_PUBLIC_MOBILE_APP_STATUS=COMING_SOON
# Store/beta destinations (only used once BETA/LIVE). Must be https on an allowed
# store host (apps.apple.com / testflight.apple.com / play.google.com) or they're
# ignored. Fill in AFTER the real store records + TestFlight/beta tracks exist.
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=
NEXT_PUBLIC_TESTFLIGHT_URL=
NEXT_PUBLIC_ANDROID_BETA_URL=

# --- Feature flags ---
# When "true", data reads will come from Supabase-backed providers instead of
# the bundled mock data. Data migration is a later slice; leave false for now.
NEXT_PUBLIC_USE_LIVE_DATA=false
