# StrikersFeed environment variables
#
# Copy this file to `.env.local` and fill in the values to connect a real
# Supabase project. WITHOUT these, the app runs in demo mode (local mock data +
# a labelled demo session) and everything still works.

# --- Supabase (Phase 2 auth) ---
# Found in your Supabase project: Settings → API.
# Setting BOTH of these switches registration/login to real authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key — never expose to the browser. Not required by the app yet;
# reserved for future admin/server tasks.
SUPABASE_SERVICE_ROLE_KEY=

# --- Feature flags ---
# When "true", data reads will come from Supabase-backed providers instead of
# the bundled mock data. Data migration is a later slice; leave false for now.
NEXT_PUBLIC_USE_LIVE_DATA=false
