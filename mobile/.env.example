# StrikersFeed mobile — PUBLIC values only (EXPO_PUBLIC_* is bundled into the app).
# Copy to .env.local and fill in. Same Supabase project as the website.
#
# NEVER put these in the mobile bundle: SUPABASE_SERVICE_ROLE_KEY,
# CLOUDFLARE_STREAM_API_TOKEN, CRON_SECRET.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SITE_URL=https://strikersfeed.club
